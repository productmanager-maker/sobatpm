    <div class="install-steps">
      <div class="install-step"><div class="install-num">1</div><div><strong>Pastikan Claude Code terinstall</strong><p><a href={`${BASE}/apa-itu-claude-code`}>Panduan →</a></p></div></div>
      <div class="install-step"><div class="install-num">2</div><div><strong>Buat <code>skills/</code></strong><p><code>mkdir skills</code></p></div></div>
