---
import SkillLayout from "../../layouts/SkillLayout.astro";

const skillCode = `
---
name: prd-generator
description: Buat Product Requirements Document (PRD) lengkap dari brief singkat.
  Aktif ketika user menyebut "buat PRD", "tulis PRD", "product requirements",
  atau memberikan brief produk untuk didokumentasikan.
---

# PRD Generator

## Format Output PRD

### 📋 Overview
**Nama Fitur:** [nama]
**Status:** Draft | **Tanggal:** [hari ini] | **Versi:** 1.0

---

### 🎯 Problem Statement
[Kondisi saat ini, pain point user, dampak jika tidak diselesaikan — 2-3 paragraf]

---

### 👥 Target User
**Primary:** [deskripsi user utama]

**User Stories:**
- Sebagai [user], saya ingin [aksi] agar [outcome]

---

### ✅ Success Metrics
| Metric | Baseline | Target | Timeline |
|--------|----------|--------|----------|
| [metric] | [saat ini] | [target] | [kapan] |

---

### 🔧 Scope
**In Scope (v1):** [daftar]
**Out of Scope:** [daftar]

---

### 📐 Requirements
| ID | Requirement | Priority |
|----|-------------|----------|
| F1 | [deskripsi] | Must Have |
| F2 | [deskripsi] | Should Have |

**Non-Functional:** Performance, Security, Accessibility

---

### 🔗 Risks & Dependencies
| Risk | Likelihood | Impact | Mitigation |
|------|------------|--------|------------|

---

### ❓ Open Questions
- [pertanyaan yang belum terjawab]

---
*Draft awal. Review dengan engineering & design sebelum development.*`;
const BASE = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<SkillLayout
  activePath="/skills/prd-generator"
  skill={{
    icon: "🧩",
    name: "PRD Generator",
    tagline: "Dari brief singkat jadi PRD lengkap siap review — dalam hitungan menit.",
    tags: ["Product Manager", "Founder"],
    category: "Product Manager",
  }}
>
  <Fragment slot="toc">
    <a href="#output" class="toc-item">Apa yang Dihasilkan</a>
    <a href="#untuk-siapa" class="toc-item">Untuk Siapa</a>
    <a href="#install" class="toc-item">Cara Install</a>
    <a href="#skill-md" class="toc-item">File SKILL.md</a>
    <a href="#contoh" class="toc-item">Contoh Nyata</a>
    <a href="#related" class="toc-item">Skills Terkait</a>
  </Fragment>

  <section class="skill-section" id="output">
    <h2>Apa yang Dihasilkan</h2>
    <p>Dari brief singkat — bahkan satu kalimat — skill ini menghasilkan PRD lengkap berstruktur:</p>
    <div class="output-list">
      <div class="output-item"><span class="output-check">✓</span><div><strong>Problem Statement</strong><p>Narasi masalah yang jelas: kondisi saat ini, pain point, dampak.</p></div></div>
      <div class="output-item"><span class="output-check">✓</span><div><strong>Target User & User Stories</strong><p>Definisi user dan story dalam format standar.</p></div></div>
      <div class="output-item"><span class="output-check">✓</span><div><strong>Success Metrics</strong><p>Tabel metric dengan baseline, target, dan timeline.</p></div></div>
      <div class="output-item"><span class="output-check">✓</span><div><strong>In/Out Scope</strong><p>Batasan yang jelas apa yang v1 dan apa yang di-defer.</p></div></div>
      <div class="output-item"><span class="output-check">✓</span><div><strong>Requirements Must/Should/Nice</strong><p>Functional dan non-functional dengan prioritas jelas.</p></div></div>
      <div class="output-item"><span class="output-check">✓</span><div><strong>Risks & Open Questions</strong><p>Risk register dan pertanyaan yang masih perlu dijawab tim.</p></div></div>
    </div>
  </section>

  <section class="skill-section" id="untuk-siapa">
    <h2>Untuk Siapa</h2>
    <div class="persona-grid">
      <div class="persona-card">👤 <strong>Product Manager</strong><br/>yang harus nulis PRD cepat setelah discovery atau planning meeting</div>
      <div class="persona-card">👤 <strong>Founder / CPO</strong><br/>yang ingin dokumentasi fitur sebelum diskusi dengan tim engineering</div>
      <div class="persona-card">👤 <strong>Associate PM</strong><br/>yang masih belajar struktur PRD yang baik dan butuh template kuat</div>
      <div class="persona-card">👤 <strong>Tim Engineering</strong><br/>yang sering menerima spec tidak lengkap dan ingin standar yang konsisten</div>
    </div>
  </section>

  <section class="skill-section" id="install">
    <h2>Cara Install — 3 Langkah</h2>
    <div class="install-steps">
      <div class="install-step"><div class="install-num">1</div><div><strong>Pastikan Claude Code terinstall</strong><p><a href={`${BASE}/apa-itu-claude-code`}>Panduan instalasi →</a></p></div></div>
      <div class="install-step"><div class="install-num">2</div><div><strong>Buat folder <code>skills/</code></strong><p><code>mkdir skills</code></p></div></div>
      <div class="install-step"><div class="install-num">3</div><div><strong>Simpan SKILL.md sebagai <code>skills/prd-generator.md</code></strong></div></div>
    </div>
  </section>

  <section class="skill-section" id="skill-md">
    <div class="code-header">
      <h2>File SKILL.md</h2>
      <button class="copy-skill-btn" data-target="skill-prd">📋 Copy SKILL.md</button>
    </div>
    <div class="code-block"><pre id="skill-prd">{skillCode}</pre></div>
  </section>

  <section class="skill-section" id="contoh">
    <h2>Contoh Nyata</h2>
    <div class="example-block">
      <div class="example-label input">Input</div>
      <div class="example-content"><p>buat PRD untuk fitur notifikasi push ke guru waktu ada siswa absen 3 hari berturut-turut</p></div>
    </div>
    <div class="example-arrow">↓ Claude menggunakan skill prd-generator</div>
    <div class="example-block">
      <div class="example-label output">Output (ringkasan)</div>
      <div class="example-content output-content">
        <h4>📋 Overview</h4>
        <p><strong>Nama Fitur:</strong> Smart Absence Alert — Notifikasi Push untuk Guru</p>
        <h4>🎯 Problem Statement</h4>
        <p>Guru tidak mendapatkan notifikasi otomatis ketika siswa absen berulang. Intervensi sering terlambat karena harus buka aplikasi manual...</p>
        <h4>✅ Success Metrics</h4>
        <table><thead><tr><th>Metric</th><th>Target</th><th>Timeline</th></tr></thead><tbody>
          <tr><td>Response rate guru</td><td>&gt;60%</td><td>30 hari post-launch</td></tr>
          <tr><td>Penurunan absensi berulang</td><td>-20%</td><td>Q2 2026</td></tr>
        </tbody></table>
        <p style="color:#94a3b8;font-size:0.8rem;margin-top:0.75rem;">+ Scope, Requirements, Risks, Open Questions...</p>
      </div>
    </div>
  </section>

  <section class="skill-section" id="related">
    <h2>Skills Terkait</h2>
    <div class="related-skills">
      <a href={`${BASE}/skills/rangkuman-meeting`} class="related-card"><span>📝</span><div><strong>Rangkuman Meeting</strong><p>Dokumentasikan hasil discovery meeting</p></div><span class="skill-arrow">→</span></a>
      <a href={`${BASE}/skills/riset-kompetitor`} class="related-card"><span>🔍</span><div><strong>Riset Kompetitor</strong><p>Analisis kompetitor sebelum tulis PRD</p></div><span class="skill-arrow">→</span></a>
    </div>
  </section>
</SkillLayout>
