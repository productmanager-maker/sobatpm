---
import BaseLayout from "./BaseLayout.astro";

export interface Props {
  title: string;
  description?: string;
  activePath: string;
  skill: {
    icon: string;
    name: string;
    tagline: string;
    tags: string[];
    popular?: boolean;
    category: string;
  };
}

const { title, description, activePath, skill } = Astro.props;
const BASE = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<BaseLayout title={`${skill.name} — SkillClaude.id`} description={description} activePath={activePath}>
  <Fragment slot="head">
    <link rel="stylesheet" href={`${BASE}/styles/skill-page.css`} />
  </Fragment>

  <header class="topbar">
    <button class="menu-btn" id="menuBtn"><span></span><span></span><span></span></button>
    <div class="topbar-right">
      <a href={`${BASE}/`} class="topbar-link">← Kembali ke semua skills</a>
    </div>
  </header>

  <div class="skill-layout">
    <article class="skill-content">
      <div class="breadcrumb">
        <a href={`${BASE}/`}>Skills</a>
        <span>›</span>
        <a href={`${BASE}/`}>{skill.category}</a>
        <span>›</span>
        <span>{skill.name}</span>
      </div>

      <div class="skill-hero">
        <div class="skill-hero-icon">{skill.icon}</div>
        <div>
          <div class="skill-tags">
            {skill.tags.map(tag => <span class="tag">{tag}</span>)}
            {skill.popular && <span class="tag tag-popular">⭐ Populer</span>}
          </div>
          <h1 class="skill-title">{skill.name}</h1>
          <p class="skill-tagline">{skill.tagline}</p>
        </div>
      </div>

      <slot />
    </article>

    <aside class="toc-sidebar">
      <div class="toc-card">
        <div class="toc-title">Di Halaman Ini</div>
        <nav class="toc-nav">
          <slot name="toc" />
        </nav>
      </div>

      <div class="cta-card">
        <div class="cta-icon">🧩</div>
        <strong>Butuh lebih dari sekedar skill?</strong>
        <p>PM Intelligence Pack berisi sistem kerja lengkap untuk Product Manager — PRD, Research, Stakeholder Deck, dan lebih banyak lagi.</p>
        <a href={`${BASE}/pm-intelligence-pack`} class="btn-cta">Lihat PM Intelligence Pack →</a>
      </div>
    </aside>
  </div>

  <footer class="footer">
    <div class="footer-inner">
      <div class="footer-brand">
        <div style="display:flex;align-items:center;gap:8px;margin-bottom:8px;">
          <span class="logo-mark small">⟨S⟩</span>
          <span class="logo-text small">SkillClaude<span class="logo-tld">.id</span></span>
        </div>
        <p>Skill Claude terbaik untuk profesional Indonesia.</p>
      </div>
      <div class="footer-links">
        <div class="footer-col">
          <div class="footer-heading">Skills</div>
          <a href={`${BASE}/skills/prd-generator`}>PRD Generator</a>
          <a href={`${BASE}/skills/rangkuman-meeting`}>Rangkuman Meeting</a>
          <a href={`${BASE}/skills/email-profesional`}>Email Profesional</a>
        </div>
        <div class="footer-col">
          <div class="footer-heading">Panduan</div>
          <a href={`${BASE}/cara-install`}>Cara Install Skill</a>
          <a href={`${BASE}/apa-itu-claude-code`}>Apa itu Claude Code?</a>
        </div>
      </div>
    </div>
    <div class="footer-bottom">
      <span>© 2026 SkillClaude.id · Dibuat oleh <strong>Sobat Produk</strong></span>
      <span class="footer-note">Skills gratis, selamanya.</span>
    </div>
  </footer>
</BaseLayout>
