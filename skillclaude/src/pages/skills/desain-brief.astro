    tagline: "Brief yang jelas untuk desainer, atau feedback konstruktif untuk revisi — dua mode dalam satu skill.",
    tags: ["Desainer", "Product Manager"],
    category: "Semua Profesi",
  }}
>
  <Fragment slot="toc">
    <a href="#output" class="toc-item">Apa yang Dihasilkan</a>
    <a href="#untuk-siapa" class="toc-item">Untuk Siapa</a>
